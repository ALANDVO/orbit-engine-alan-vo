# Orbit Engine - Environment Configuration
# Copy to .env and fill in values

# Database
DATABASE_URL=postgresql+asyncpg://orbit:orbit@localhost:5432/orbit

# Keycloak / OIDC
OIDC_ISSUER_URL=http://localhost:8080/realms/orbit
OIDC_CLIENT_ID=orbit-engine
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:5173/callback
OIDC_AUDIENCE=orbit-engine

# LLM (optional)
LLM_API_KEY=
LLM_PROVIDER=openai-compatible
LLM_MODEL=
LLM_BASE_URL=

# CORS
CORS_ORIGINS=http://localhost:5173

# Demo mode (local only)
DEMO_MODE=true
DEBUG=true